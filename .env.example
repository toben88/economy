# Copy to .env and fill in. Never commit .env.

# Free key from https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Long random string that authorizes manual updates via POST /api/ingest.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# Hour (UTC, 0-23) of the daily FRED update. Default 15, after US morning releases reach FRED.
# INGEST_HOUR_UTC=15

# Where the SQLite file lives. The Docker image sets /data/economy.db; locally it defaults to ./data/economy.db.
# DATABASE_PATH=
